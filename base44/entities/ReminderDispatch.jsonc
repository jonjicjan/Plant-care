{
  "name": "ReminderDispatch",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "User who received the reminder"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email"
      ],
      "description": "Delivery channel of the reminder"
    },
    "dedupeKey": {
      "type": "string",
      "description": "Unique key that prevents the same reminder being sent twice"
    },
    "dueDateKey": {
      "type": "string",
      "description": "Local date the reminder covers, YYYY-MM-DD"
    },
    "taskCount": {
      "type": "number",
      "description": "Number of care tasks included in the reminder"
    },
    "pendingCount": {
      "type": "number",
      "description": "Care tasks still not completed when the reminder was sent"
    },
    "completedCount": {
      "type": "number",
      "description": "Care tasks marked completed on the reminder day"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the reminder was handed to the email service"
    }
  },
  "required": [
    "userId",
    "channel",
    "dedupeKey"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}